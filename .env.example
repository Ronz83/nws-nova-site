# ─────────────────────────────────────────────
# NWS Nova Site — Environment Variables
# Copy this file to .env.local and fill in values
# NEVER commit .env.local to git
# ─────────────────────────────────────────────

# ── GHL (GoHighLevel) Connector ──────────────
# Your GHL Location API key (Settings → API Keys)
VITE_GHL_API_KEY=

# GHL Location ID (Settings → Business Profile)
VITE_GHL_LOCATION_ID=

# GHL Sub-account API base (usually https://rest.gohighlevel.com/v1)
VITE_GHL_API_BASE=https://rest.gohighlevel.com/v1

# GHL Calendar ID for booking widget
VITE_GHL_CALENDAR_ID=7XM9CtPbOpvqKfdXXFeq

# ── NWS Backend API (Nova AI / Antigravity connector) ──
VITE_API_URL=https://antigravity-app-9ao8.onrender.com

# Business OS (identity/permissions/data hub). Novelty has no database of its own.
BUSINESS_OS_URL=
BUSINESS_OS_SERVICE_TOKEN=
# Signs the short Novelty session cookie (uid/exp only). Not shared with Business OS.
SESSION_SECRET=
SSO_REDIRECT_BASE=

# ── Analytics (optional) ─────────────────────
VITE_GA_MEASUREMENT_ID=

# NWS Location ID — used by /api/ghl/feature-flags fallback and demo login
NWS_LOCATION_ID=PiPGhGQUHooNH7p8no1p
VITE_NWS_LOCATION_ID=PiPGhGQUHooNH7p8no1p
